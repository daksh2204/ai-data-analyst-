# ---------------------------------------------------------------------------
# AI Data Analyst configuration. Copy to `.env` and fill in ONE provider key.
# With no key the app still runs, on the built-in offline engine.
# ---------------------------------------------------------------------------

# auto = first provider below that has a key. Or: anthropic | openai | gemini | groq | openrouter | ollama | offline
LLM_PROVIDER=auto
# Optional model override (defaults: anthropic=claude-sonnet-5-5, openai=gpt-5.4-mini,
# gemini=gemini-2.5-flash, groq=openai/gpt-oss-120b, ollama=qwen2.5:7b)
# LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free tiers that work well: Google AI Studio (Gemini) and Groq.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Local models via Ollama, e.g. http://localhost:11434 (use http://host.docker.internal:11434 from Docker)
# OLLAMA_BASE_URL=

# Answer with the offline engine if the LLM call fails (quota, network...)
LLM_FALLBACK_TO_OFFLINE=true
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
AGENT_MAX_STEPS=8

# --- Security --------------------------------------------------------------
# When set, the UI asks for this token and every /api call must send it.
# APP_ACCESS_TOKEN=change-me

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_FILES_PER_SESSION=10
QUERY_TIMEOUT_SECONDS=15
PANDAS_TIMEOUT_SECONDS=10
SESSION_TTL_MINUTES=120
# Questions per minute per client (protects LLM spend); 0 disables
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# json for log aggregation, text for local development
LOG_FORMAT=text
